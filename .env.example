# ETL_DB_BACKEND=sqlite
# ETL_PG_HOST=localhost
# ETL_PG_PORT=5432
# ETL_PG_DBNAME=etl
# ETL_PG_USER=etl
# ETL_PG_PASSWORD=  # never commit a real password; export it in your shell
